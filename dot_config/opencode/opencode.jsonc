{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "awk *": "allow",
      "cat *": "allow",
      "cut *": "allow",
      "diff *": "allow",
      "docker info": "allow",
      "du *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "gh issue view *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh project view *": "allow",
      "gh repo view *": "allow",
      "gh run view *": "allow",
      "gh search *": "allow",
      "gh workflow view *": "allow",
      "git blame *": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch -vv": "allow",
      "git config --get *": "allow",
      "git count-objects *": "allow",
      "git describe *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git merge-base *": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "git tag": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "nl *": "allow",
      "printf *": "allow",
      "pwd *": "allow",
      "rg *": "allow",
      "ruff *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "tac *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "touch *": "allow",
      "tr *": "allow",
      "wc *": "allow",
      "xargs grep *": "allow",
      "xargs head *": "allow",
      "xargs rg *": "allow",
      "poetry env info *": "allow",
      "poetry run mypy *": "allow",
      "poetry run pylint *": "allow",
      "poetry run pytest *": "allow",
      "poetry run ruff *": "allow",
      "python -m flake8 *": "allow",
      "python -m mypy *": "allow",
      "python -m pytest *": "allow",
      "uniq *": "allow",
      "uv run mypy *": "allow",
      "uv run pylint *": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow"
    },
    "external_directory": {
      "~/.cache/pypoetry/virtualenvs/**": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "~/.cache/pypoetry/virtualenvs/**": "deny",
      "~/.cache/uv/archive-v0/**": "deny"
    }
  },
  "agent": {
    "explore": {
      "model": "anthropic/claude-sonnet-5-5"
    },
    "general": {
      "model": "anthropic/claude-haiku-5-5"
    }
  },
  "small_model": "anthropic/claude-haiku-5-5",
  "plugins": [
    "opencode-with-claude"
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:3456/v1",
        "apiKey": "dummy"
      }
    }
  }
}
